# Keep this file as a template. Put real values in .env, which Git ignores.
CREATOR_PRIVATE_KEY=
SOLANA_RPC_URL=https://rpc.solanatracker.io/public

# Safety switch: use dry-run first, then change to live when the output is correct.
RUN_MODE=dry-run

# BURNY
TOKEN_MINT=FBJ3Pm1ngPYfEGhcvWBBKpShdyd1Z6iNt6cByqeDpump
BUYBACK_PERCENT=50
SLIPPAGE_PERCENT=2

# Skip tiny claims/buys that would waste transaction fees.
MIN_CLAIM_SOL=0.01
MIN_BUY_SOL=0.005
MIN_WALLET_RESERVE_SOL=0.02

# Used by `pnpm buyback-burn:watch`.
INTERVAL_SECONDS=900

# Pump.fun transaction builder. Change only if Pump.fun publishes a replacement.
PUMP_API_URL=https://fun-block.pump.fun
